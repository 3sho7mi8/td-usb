<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tokyodevices.iws660-lunar</string>

    <key>Comment</key>
    <string>IWS660-CS Lunar integration service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yoshino/Workspace/_archive/td-usb/scripts/start-lunar-integration.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yoshino/Library/Logs/td-usb/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/yoshino/Library/Logs/td-usb/launchd-error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/yoshino/Workspace/_archive/td-usb</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
